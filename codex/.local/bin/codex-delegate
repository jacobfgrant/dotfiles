#!/usr/bin/env python3
"""Run Codex non-interactively with the model, effort, and permissions pinned per intent.

Each subcommand maps an intent to a permission profile from ~/.codex/config.toml,
a model, an effort, and a fixed set of `codex exec` flags. Nothing can pass
--sandbox or a bypass flag through it, and a project with its own .codex/
configuration is refused. Read-only runs get a per-run scratch directory for temp
files so tests can run; it is removed afterwards. Then the wrapper reads the Codex
session file and reports the model, effort, and profile that actually applied. `show` does that for any
session; `doctor` checks the install and sandbox without calling a model.
"""

from __future__ import annotations

import sys

if sys.version_info < (3, 11):
    sys.exit("codex-delegate needs Python 3.11 or newer")

import argparse
import datetime as dt
import json
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import tempfile
import time
import tomllib
from contextlib import contextmanager
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Iterable, Iterator

DEFAULT_MODEL = "gpt-6.1-sol"
ESCALATION_MODEL = "gpt-6-astra"
DEFAULT_EFFORT = "high"
EFFORTS = ("low", "medium", "high", "xhigh", "max", "ultra")

# How long to wait after exit for Codex to flush the session's turn context.
ROLLOUT_FLUSH_WAIT_S = 15

# Anything in the scratch parent older than this was left by a run that is over; the next run removes it.
SCRATCH_STALE_S = 24 * 60 * 60

# Bumped by /codex-audit; doctor prints it next to the installed version.
VALIDATED_CODEX_VERSION = "0.167.0"

PROFILE_FOR_INTENT = {
    "review": "review",
    "adversarial": "review",
    "consult": "review",
    "implement": "development",
}

# Codex loads a project's own .codex/ layers (config.toml, hooks.json, rules)
# only when the project's git root is trusted in [projects], and then they
# override the user config. In a trusted project these keys can change what
# the sandbox lets a command do; anything else is left to the post-run check.
SANDBOX_CHANGING_KEYS = (
    "sandbox_mode",
    "sandbox_workspace_write",
    "sandbox_permissions",
    "default_permissions",
    "permissions",
    "approval_policy",
    "approvals_reviewer",
    "hooks",
    "mcp_servers",
)
# An `allow` rule runs its command outside the sandbox entirely. Rules files
# are Starlark, so either quote style is valid.
ALLOW_RULE = re.compile(r"""decision\s*=\s*(?:"allow"|'allow')""")

# Flags the wrapper relies on. `doctor` confirms each still appears in --help.
REQUIRED_EXEC_FLAGS = ("--json", "--output-last-message", "--output-schema", "--model", "--config", "--worktree")
REQUIRED_REVIEW_FLAGS = ("--json", "--output-last-message", "--model", "--config", "--base", "--uncommitted")

ADVERSARIAL_PROMPT = """\
You are reviewing a change as an independent, skeptical second reviewer.

Inspect the repository yourself: read the diff, the surrounding code, callers,
tests, and configuration. Do not take the description of the change at face
value. Challenge the approach, not just the implementation: question the
assumptions it depends on, look for failure modes under real-world conditions
(partial failure, retries, concurrency, rollback, stale state, resource
exhaustion, version skew), and consider whether a simpler or safer design was
available.

Report only findings you can ground in specific files or command output. For
each finding give the location, the concrete claim, the evidence, and a
suggested direction. Rank by severity: P0 (must fix before shipping),
P1 (should fix), P2 (worth fixing), P3 (nit or question). Severity follows
demonstrated impact under realistic use, not how surprising the code looks.
A choice the request lists as deliberate is not a finding, though a concrete
consequence of it the author may not have foreseen is, at P3. A verdict of
fix-first needs an evidenced P0 or P1. If you find nothing blocking, say so;
do not invent findings to fill the report.

{scope}
{focus}"""

FINDINGS_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["verdict", "summary", "findings"],
    "properties": {
        "verdict": {"type": "string", "enum": ["ship", "fix-first", "rethink"]},
        "summary": {"type": "string"},
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["title", "severity", "location", "claim", "evidence", "suggested_direction"],
                "properties": {
                    "title": {"type": "string"},
                    "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
                    "location": {"type": "string"},
                    "claim": {"type": "string"},
                    "evidence": {"type": "string"},
                    "suggested_direction": {"type": "string"},
                },
            },
        },
    },
}


class DelegateError(Exception):
    """A usage or environment error the wrapper can explain to the caller."""


@dataclass
class Request:
    """Everything needed to build one Codex invocation."""

    intent: str
    cwd: Path
    model: str | None = DEFAULT_MODEL
    effort: str | None = DEFAULT_EFFORT
    base: str | None = None
    worktree: bool = False
    session_id: str | None = None
    write: bool = False
    allow_project_config: bool = False
    # Turn ids the session already had before this run; only a newer turn can
    # verify a resume, otherwise the report would describe the previous run.
    prior_turn_ids: set[str] = field(default_factory=set)

    @property
    def profile(self) -> str:
        if self.intent == "resume":
            return "development" if self.write else "review"
        return PROFILE_FOR_INTENT[self.intent]


@dataclass
class RolloutSummary:
    """What the Codex session file says actually happened."""

    session_id: str | None = None
    cli_version: str | None = None
    cwd: str | None = None
    model: str | None = None
    effort: str | None = None
    profile: str | None = None
    sandbox: str | None = None
    writes: list[str] = field(default_factory=list)  # paths the sandbox let commands write
    approval_policy: str | None = None
    last_message: str | None = None
    turns: int = 0
    turn_ids: set[str] = field(default_factory=set)


@dataclass
class Check:
    """One doctor check."""

    name: str
    ok: bool
    detail: str
    warning: bool = False
    skipped: bool = False


# --- Command construction ---------------------------------------------------


def config_override(key: str, value: str) -> list[str]:
    """Return a -c override; the value is quoted so Codex parses it as a TOML string."""
    return ["-c", f'{key}="{value}"']


def build_command(request: Request, output_file: Path, schema_file: Path | None = None) -> list[str]:
    """Build the codex argv for a request. Prompts are read from stdin, never argv."""
    argv = ["codex", "exec"]
    if request.intent == "review":
        argv.append("review")
        argv += ["--base", request.base] if request.base else ["--uncommitted"]
    elif request.intent == "resume":
        argv += ["resume", request.session_id]

    argv += config_override("default_permissions", request.profile)
    if request.effort:  # resume inherits the session's effort and model unless told otherwise
        argv += config_override("model_reasoning_effort", request.effort)
    if request.model:
        argv += ["--model", request.model]
    argv += ["--json", "--output-last-message", str(output_file)]
    if schema_file is not None:
        argv += ["--output-schema", str(schema_file)]
    if request.worktree:
        argv.append("--worktree")
    if request.intent != "review":
        argv.append("-")  # prompt on stdin
    return argv


def git_output(args: list[str], cwd: Path) -> str:
    """Run a git command and return stdout, or an empty string if it fails."""
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def trusted_projects() -> set[Path]:
    """Project roots marked trusted in the user config's [projects] table."""
    config_path = codex_home() / "config.toml"
    if not config_path.is_file():
        return set()
    try:
        projects = tomllib.loads(config_path.read_text(encoding="utf-8")).get("projects", {})
    except tomllib.TOMLDecodeError:
        return set()
    return {Path(path).expanduser().resolve() for path, entry in projects.items() if entry.get("trust_level") == "trusted"}


def project_config_layers(cwd: Path) -> list[Path]:
    """Directories whose .codex/ layer Codex loads: the git toplevel down to cwd."""
    cwd = cwd.resolve()
    toplevel = git_output(["rev-parse", "--show-toplevel"], cwd)
    root = Path(toplevel).resolve() if toplevel else cwd
    if root == cwd or root not in cwd.parents:
        return [cwd]
    return [root, *(parent for parent in reversed(cwd.parents) if root in parent.parents), cwd]


def project_is_trusted(cwd: Path, layers: list[Path]) -> bool:
    """Codex trusts a layer if it, the project root, or the main checkout of a linked worktree is trusted."""
    trusted = trusted_projects()
    if trusted & set(layers):
        return True
    common_dir = git_output(["rev-parse", "--git-common-dir"], cwd)  # relative to cwd on older git
    return bool(common_dir) and (cwd.resolve() / common_dir).resolve().parent in trusted


def project_config_problems(cwd: Path) -> list[str]:
    """Project .codex/ files that could widen the sandbox. Empty unless the project is trusted."""
    layers = project_config_layers(cwd)
    if not project_is_trusted(cwd, layers):
        return []
    problems = []
    for layer in layers:
        codex_dir = layer / ".codex"
        config_path = codex_dir / "config.toml"
        if config_path.is_file():
            try:
                config = tomllib.loads(config_path.read_text(encoding="utf-8"))
            except tomllib.TOMLDecodeError as exc:
                problems.append(f"{config_path} does not parse: {exc}")
            else:
                keys = [key for key in SANDBOX_CHANGING_KEYS if key in config]
                if keys:
                    problems.append(f"{config_path} sets {', '.join(keys)}")
        if (codex_dir / "hooks.json").is_file():
            problems.append(f"{codex_dir / 'hooks.json'} defines hooks, which run outside the sandbox")
        for rules_path in sorted((codex_dir / "rules").glob("*.rules")):
            if ALLOW_RULE.search(rules_path.read_text(encoding="utf-8")):
                problems.append(f"{rules_path} contains an allow rule, which runs its command outside the sandbox")
    return problems


def describe_scope(request: Request) -> str:
    """Tell the reviewer which changes are in scope without interpreting them."""
    if request.base:
        stat = git_output(["diff", "--stat", f"{request.base}...HEAD"], request.cwd)
        return (
            f"Scope: the changes on this branch relative to `{request.base}` "
            f"(`git diff {request.base}...HEAD`).\n\n{stat}"
        )
    stat = git_output(["diff", "--stat", "HEAD"], request.cwd)
    untracked = git_output(["ls-files", "--others", "--exclude-standard"], request.cwd)
    parts = ["Scope: the uncommitted changes in the working tree, staged and unstaged, plus untracked files."]
    if stat:
        parts.append(stat)
    if untracked:
        parts.append("Untracked files:\n" + untracked)
    return "\n\n".join(parts)


def adversarial_prompt(request: Request, focus: str) -> str:
    """Compose the adversarial review prompt with scope and optional focus text."""
    focus_block = f"Pay particular attention to: {focus.strip()}" if focus.strip() else ""
    return ADVERSARIAL_PROMPT.format(scope=describe_scope(request), focus=focus_block).rstrip() + "\n"


# --- Running Codex ----------------------------------------------------------


@dataclass
class RunResult:
    exit_code: int
    thread_id: str | None
    errors: list[str]
    agent_messages: list[str]
    duration_s: float


def parse_event(line: str) -> dict | None:
    """Parse one JSONL event from `codex exec --json`, ignoring non-JSON noise."""
    line = line.strip()
    if not line.startswith("{"):
        return None
    try:
        return json.loads(line)
    except json.JSONDecodeError:
        return None


def run_codex(argv: list[str], cwd: Path, stdin_text: str | None, env: dict[str, str] | None = None,
              verbose: bool = False) -> RunResult:
    """Run codex, streaming its JSONL events, and collect what the report needs."""
    started = time.monotonic()
    try:
        process = subprocess.Popen(
            argv,
            cwd=cwd,
            env={**os.environ, **env} if env else None,
            stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=None,  # Codex's own stderr passes straight through
            text=True,
        )
    except FileNotFoundError:
        raise DelegateError("codex not found on PATH") from None
    thread_id = None
    errors: list[str] = []
    agent_messages: list[str] = []
    try:
        if stdin_text is not None:
            try:
                process.stdin.write(stdin_text)
                process.stdin.close()
            except BrokenPipeError:
                pass  # codex exited before reading the prompt; its exit code and stderr say why
        for line in process.stdout:
            event = parse_event(line)
            if event is None:
                continue
            if verbose:
                print(line.rstrip(), file=sys.stderr)
            kind = event.get("type")
            if kind == "thread.started":
                thread_id = event.get("thread_id")
                # Printed early so an interrupted run still leaves an id for `show`.
                print(f"session started: {thread_id}", file=sys.stderr, flush=True)
            elif kind == "error":
                message = str(event.get("message") or event)
                errors.append(message)
                print(f"codex error: {message}", file=sys.stderr)
            elif kind == "item.completed":
                item = event.get("item") or {}
                if item.get("type") == "agent_message" and item.get("text"):
                    agent_messages.append(item["text"])
        exit_code = process.wait()
    finally:
        if process.poll() is None:  # the wrapper is being torn down; take codex with it, and wait so it stops writing
            process.terminate()
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
    return RunResult(exit_code, thread_id, errors, agent_messages, time.monotonic() - started)


# --- Scratch directory ------------------------------------------------------
#
# The review profile is read-only everywhere, including the temp directory, so
# heredocs, mktemp, and test fixtures fail. Each read-only run gets a fresh
# directory under this one, the only writable path in the profile, and the
# usual temp-file variables point at it.


def scratch_parent() -> Path:
    """The one directory the review profile may write in; it holds a subdirectory per run."""
    return Path.home() / ".cache" / "codex-delegate" / "scratch"


def scratch_env(scratch: Path) -> dict[str, str]:
    """Send temp files from the sandboxed commands into the scratch directory."""
    return {
        "TMPDIR": str(scratch),
        "TMPPREFIX": str(scratch / "zsh"),  # zsh heredocs use this, not TMPDIR
        # .pytest_cache would otherwise land in the read-only repo; options already in the environment are kept.
        "PYTEST_ADDOPTS": " ".join(filter(None, [os.environ.get("PYTEST_ADDOPTS"), f"-o cache_dir={shlex.quote(str(scratch / 'pytest-cache'))}"])),
    }


def remove_scratch(scratch: Path) -> None:
    """Remove one run's scratch directory. Symlinks, at the path or inside it, are removed, never their targets."""
    try:
        if scratch.is_symlink():  # sandboxed code can rename its directory and leave a link in its place
            scratch.unlink()
            return
        # A test may leave a read-only or unreadable directory behind; make each one ours to delete again.
        # Only real directories are touched: chmod on a symlink would change its target, and on macOS the
        # no-follow form rules that out even if a link appears between the check and the call.
        nofollow = {"follow_symlinks": False} if os.chmod in os.supports_follow_symlinks else {}
        os.chmod(scratch, 0o700, **nofollow)
        for root, dirs, _files in os.walk(scratch):
            for name in dirs:
                child = os.path.join(root, name)
                if not os.path.islink(child):
                    os.chmod(child, 0o700, **nofollow)
        shutil.rmtree(scratch)
    except FileNotFoundError:
        pass  # a concurrent sweep removed it first
    except OSError as exc:
        print(f"codex-delegate: could not fully remove {scratch}: {exc}", file=sys.stderr)


@contextmanager
def run_scratch(profile: str) -> Iterator[dict[str, str] | None]:
    """A fresh scratch directory for a read-only run, removed afterwards; anything a day old in the parent goes too."""
    if profile != "review":
        yield None
        return
    parent = scratch_parent()
    parent.mkdir(parents=True, exist_ok=True)
    if parent.is_symlink():
        raise DelegateError(f"{parent} is a symlink; refusing to clean up through it")
    cutoff = time.time() - SCRATCH_STALE_S
    # Everything here was written by a sandboxed run, usually inside its own run-* directory but a model
    # may also write to the parent directly. A day old means that run is long gone.
    for stale in parent.iterdir():
        try:
            info = stale.lstat()  # one call, so a concurrent sweep removing it first is just a miss
        except FileNotFoundError:
            continue
        if info.st_mtime >= cutoff:
            continue
        if stat.S_ISDIR(info.st_mode):
            remove_scratch(stale)
        else:
            stale.unlink(missing_ok=True)  # a file, or a symlink: the link itself, never its target
    scratch = Path(tempfile.mkdtemp(prefix="run-", dir=parent))
    try:
        yield scratch_env(scratch)
    finally:
        remove_scratch(scratch)


# --- Session rollouts -------------------------------------------------------


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()


def find_rollout(session_id: str, home: Path | None = None) -> Path | None:
    """Locate the rollout file for a session id under CODEX_HOME/sessions."""
    sessions = (home or codex_home()) / "sessions"
    if not sessions.is_dir():
        return None
    matches = sorted(sessions.glob(f"*/*/*/rollout-????-??-??T??-??-??-{session_id}.jsonl"))
    return matches[-1] if matches else None


def record_turn_ids(summary: RolloutSummary, payload: dict) -> None:
    summary.turn_ids.update(t for t in (payload.get("turn_id"), payload.get("root_turn_id")) if t)


def writable_paths(policy: dict | None) -> list[str]:
    """Write entries from Codex's resolved filesystem policy; the legacy sandbox_policy summary leaves the workspace out."""
    paths = []
    for entry in (policy or {}).get("entries", []):
        if entry.get("access") != "write":
            continue
        location = entry.get("path") or {}
        if location.get("type") == "special":
            paths.append(":" + str((location.get("value") or {}).get("kind")))
        else:
            paths.append(str(location.get("path") or location.get("pattern") or location))
    return paths


def summarize_rollout(lines: Iterable[str]) -> RolloutSummary:
    """Extract model, effort, profile, sandbox, and the last message from rollout records.

    Every turn_context record overwrites the per-turn fields, so a turn that
    omits one reports None rather than inheriting the previous turn's value.
    """
    summary = RolloutSummary()
    for line in lines:
        record = parse_event(line)
        if record is None:
            continue
        payload = record.get("payload") or {}
        kind = record.get("type")
        if kind == "session_meta":
            summary.session_id = payload.get("id") or payload.get("session_id")
            summary.cli_version = payload.get("cli_version")
            summary.cwd = payload.get("cwd")
        elif kind == "turn_context":
            summary.turns += 1
            record_turn_ids(summary, payload)
            summary.model = payload.get("model")
            summary.effort = payload.get("effort")
            summary.approval_policy = payload.get("approval_policy")
            summary.cwd = payload.get("cwd") or summary.cwd
            active = payload.get("active_permission_profile")
            summary.profile = active.get("id") if isinstance(active, dict) else (active if isinstance(active, str) else None)
            sandbox = payload.get("sandbox_policy")
            summary.sandbox = sandbox.get("type") if isinstance(sandbox, dict) else None
            summary.writes = writable_paths(payload.get("file_system_sandbox_policy"))
        elif kind == "event_msg" and payload.get("type") in ("task_started", "task_complete"):
            record_turn_ids(summary, payload)
            if payload.get("type") == "task_complete":
                summary.last_message = payload.get("last_agent_message") or summary.last_message
    return summary


def read_summary(path: Path) -> RolloutSummary:
    with path.open(encoding="utf-8") as handle:
        return summarize_rollout(handle)


def find_child_rollouts(parent: Path, session_id: str) -> list[Path]:
    """Rollouts whose session_meta names this session as parent, oldest first.

    `codex exec review` does its work in a subagent thread; the parent thread only
    records the final message, so model and profile have to come from the child.
    Children land in the day directory of when they started, so the parent's
    directory and today's are both searched.
    """
    sessions = parent.parents[3]
    today = dt.date.today()
    day_dirs = {parent.parent, sessions / f"{today:%Y}" / f"{today:%m}" / f"{today:%d}"}
    children = []
    for day_dir in day_dirs:
        for candidate in day_dir.glob("rollout-*.jsonl"):
            if candidate == parent:
                continue
            with candidate.open(encoding="utf-8") as handle:
                meta = parse_event(handle.readline() or "")
            payload = (meta or {}).get("payload") or {}
            if meta and meta.get("type") == "session_meta" and payload.get("parent_thread_id") == session_id:
                children.append(candidate)
    return sorted(children, key=lambda p: p.name)


def merge_child_turn_context(summary: RolloutSummary, parent: Path, session_id: str, new_turn_ids: set[str]) -> None:
    """Fill the per-turn fields from the newest child thread that ran one of this run's turns."""
    for child in reversed(find_child_rollouts(parent, session_id)):
        child_summary = read_summary(child)
        if child_summary.turns > 0 and child_summary.turn_ids & new_turn_ids:
            for name in ("model", "effort", "profile", "sandbox", "writes", "approval_policy", "turns"):
                setattr(summary, name, getattr(child_summary, name))
            summary.last_message = summary.last_message or child_summary.last_message
            return


def clear_turn_fields(summary: RolloutSummary) -> None:
    """Leave only session-level facts; the per-turn fields could not be verified for this run."""
    summary.model = summary.effort = summary.profile = summary.sandbox = summary.approval_policy = None
    summary.writes = []
    summary.turns = 0


def load_summary(session_id: str, wait_s: float = 0, prior_turn_ids: set[str] | None = None) -> RolloutSummary | None:
    """Summarize a session's rollout, waiting up to wait_s for a turn newer than prior_turn_ids.

    Codex writes the rollout asynchronously, so right after `codex exec` exits the
    file can still lack the turn_context record that names the model and profile.
    A resumed session already holds earlier turns, which is why only a turn id
    not in prior_turn_ids counts. When the session delegated its work to a child
    thread, the child's turn context is used and the parent keeps the final
    message. If no new turn appears in time, the per-turn fields are cleared so
    the report says unverified rather than describing an earlier run.
    """
    prior = prior_turn_ids or set()
    deadline = time.monotonic() + wait_s
    while True:
        path = find_rollout(session_id)
        summary = read_summary(path) if path is not None else None
        if summary is not None:
            new_turn_ids = summary.turn_ids - prior
            if summary.turns == 0 and new_turn_ids:
                merge_child_turn_context(summary, path, session_id, new_turn_ids)
            if summary.turns > 0 and new_turn_ids:
                return summary
        if time.monotonic() >= deadline:
            if summary is not None:
                clear_turn_fields(summary)
            return summary
        time.sleep(0.5)


# --- Reports ----------------------------------------------------------------


def build_report(request: Request, argv: list[str], run: RunResult, last_message: str | None) -> dict:
    """Combine what was requested with what the rollout says happened."""
    summary = load_summary(run.thread_id, ROLLOUT_FLUSH_WAIT_S, request.prior_turn_ids) if run.thread_id else None
    warnings: list[str] = []
    if summary is None:
        warnings.append("session rollout not found; model, effort, and profile unverified")
    elif summary.turns == 0:
        warnings.append("no turn context recorded for this run; model, effort, and profile unverified")
    else:
        if request.model and summary.model != request.model:
            warnings.append(f"model mismatch: requested {request.model}, session ran {summary.model}")
        if request.effort and summary.effort != request.effort:
            warnings.append(f"effort mismatch: requested {request.effort}, session ran {summary.effort}")
        if summary.profile != request.profile:
            warnings.append(f"profile mismatch: requested {request.profile}, session used {summary.profile or 'none'}")
        if request.profile == "review":
            extra = [w for w in summary.writes if not w.startswith("/") or Path(w).resolve() != scratch_parent().resolve()]
            if extra:
                warnings.append(f"review run could write beyond the scratch dir: {', '.join(extra)}")
    if run.errors:
        warnings.extend(f"codex reported: {error}" for error in run.errors)

    message = last_message or (run.agent_messages[-1] if run.agent_messages else None)
    findings = None
    if request.intent == "adversarial" and message:
        try:
            findings = json.loads(message)
        except json.JSONDecodeError:
            warnings.append("adversarial output was not valid JSON; showing raw text")

    return {
        "intent": request.intent,
        "cwd": str(request.cwd),
        "model_requested": request.model,
        "model_actual": summary.model if summary else None,
        "effort_requested": request.effort,
        "effort_actual": summary.effort if summary else None,
        "profile_requested": request.profile,
        "profile_actual": summary.profile if summary else None,
        "sandbox": describe_sandbox(summary) if summary else None,
        "approval_policy": summary.approval_policy if summary else None,
        "cwd_actual": summary.cwd if summary else None,
        "session_id": run.thread_id,
        "cli_version": summary.cli_version if summary else None,
        "exit_code": run.exit_code,
        "duration_s": round(run.duration_s, 1),
        "warnings": warnings,
        "findings": findings,
        "message": message,
        "command": argv,
    }


def describe_sandbox(summary: RolloutSummary) -> str | None:
    """Codex labels any profile with a writable path "workspace-write"; say which paths those are instead."""
    if not summary.writes:
        return summary.sandbox
    home = str(Path.home()) + "/"
    return "writes in " + ", ".join("~/" + w[len(home):] if w.startswith(home) else w for w in summary.writes)


def print_report(report: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2))
        return
    header = [
        f"intent:    {report['intent']}",
        f"model:     {report['model_requested'] or 'inherited'} -> {report['model_actual'] or 'unverified'}",
        f"effort:    {report['effort_requested'] or 'inherited'} -> {report['effort_actual'] or 'unverified'}",
        f"profile:   {report['profile_requested']} -> {report['profile_actual'] or 'unverified'}"
        + (f" ({report['sandbox']})" if report.get("sandbox") else ""),
        f"session:   {report['session_id'] or 'unknown'}",
        f"exit:      {report['exit_code']}  ({report['duration_s']}s)",
    ]
    if report.get("cwd_actual") and report["cwd_actual"] != report["cwd"]:
        header.append(f"workspace: {report['cwd_actual']}")
    for warning in report["warnings"]:
        header.append(f"WARNING:   {warning}")
    print("\n".join(header))
    print("---")
    if report.get("findings") is not None:
        print(json.dumps(report["findings"], indent=2))
    else:
        print(report["message"] or "(no final message)")


def print_summary(summary: RolloutSummary, as_json: bool) -> None:
    if as_json:
        print(json.dumps({**asdict(summary), "turn_ids": sorted(summary.turn_ids)}, indent=2))
        return
    print(
        "\n".join(
            [
                f"session:   {summary.session_id}",
                f"model:     {summary.model} ({summary.effort})",
                f"profile:   {summary.profile} ({describe_sandbox(summary)})",
                f"approval:  {summary.approval_policy}",
                f"cwd:       {summary.cwd}",
                f"codex:     {summary.cli_version}",
                f"turns:     {summary.turns}",
            ]
        )
    )
    print("---")
    print(summary.last_message or "(no final message)")


# --- Doctor -----------------------------------------------------------------


def run_capture(argv: list[str], cwd: Path | None = None, timeout: int = 60, env: dict | None = None) -> subprocess.CompletedProcess:
    """Run a command for its output; a timeout or missing binary becomes a failed result, not a traceback."""
    try:
        return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"timed out after {timeout}s")
    except FileNotFoundError:
        return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]} not found")


def codex_version() -> str | None:
    result = run_capture(["codex", "--version"])
    return result.stdout.strip().split()[-1] if result.stdout.strip() else None


def check_binary(version: str | None) -> Check:
    if shutil.which("codex") is None:
        return Check("codex binary", False, "codex not found on PATH")
    if not version:
        return Check("codex binary", False, "could not read codex --version")
    return Check("codex binary", True, f"codex {version} (wrapper validated against {VALIDATED_CODEX_VERSION})")


def check_codex_doctor(doctor_json: str) -> Check:
    """Read Codex's own doctor report for config load and auth status."""
    try:
        report = json.loads(doctor_json)
    except json.JSONDecodeError:
        return Check("codex doctor", False, "codex doctor --json did not return JSON")
    checks = report.get("checks") or {}
    problems = []
    for check_id in ("config.load", "auth.credentials"):
        status = (checks.get(check_id) or {}).get("status")
        if status != "ok":
            problems.append(f"{check_id}: {status or 'missing'}")
    if problems:
        return Check("codex doctor", False, "; ".join(problems))
    return Check("codex doctor", True, "config loads and auth is configured")


def check_models(catalog_text: str) -> Check:
    try:
        catalog = json.loads(catalog_text)
    except json.JSONDecodeError:
        return Check("model catalog", False, "codex debug models did not return JSON")
    models = {m.get("slug"): m for m in catalog.get("models", [])}
    missing = [slug for slug in (DEFAULT_MODEL, ESCALATION_MODEL) if slug not in models]
    if missing:
        return Check("model catalog", False, f"missing from catalog: {', '.join(missing)}")
    for slug in (DEFAULT_MODEL, ESCALATION_MODEL):
        efforts = {level.get("effort") for level in models[slug].get("supported_reasoning_levels", [])}
        if DEFAULT_EFFORT not in efforts:
            return Check("model catalog", False, f"{slug} does not support effort {DEFAULT_EFFORT}")
    listed = ", ".join(slug for slug, m in models.items() if m.get("visibility") == "list")
    return Check("model catalog", True, f"{DEFAULT_MODEL} and {ESCALATION_MODEL} available; listed: {listed}")


def check_flags(name: str, help_text: str, required: tuple[str, ...]) -> Check:
    missing = [flag for flag in required if not re.search(rf"(?<![\w-]){re.escape(flag)}(?![\w-])", help_text)]
    if missing:
        return Check(name, False, f"flags missing from --help: {', '.join(missing)}")
    return Check(name, True, "all required flags present")


def check_config_file(config_text: str) -> Check:
    try:
        config = tomllib.loads(config_text)
    except tomllib.TOMLDecodeError as exc:
        return Check("config profiles", False, f"config.toml does not parse: {exc}")
    problems = []
    if "default_permissions" not in config:
        problems.append("default_permissions is not set")
    for legacy in ("sandbox_mode", "sandbox_workspace_write"):
        if legacy in config:
            problems.append(f"{legacy} is set and would override permission profiles")
    profiles = config.get("permissions", {})
    for name in ("review", "development"):
        if name not in profiles:
            problems.append(f"[permissions.{name}] is missing")
    if problems:
        return Check("config profiles", False, "; ".join(problems))
    return Check("config profiles", True, "review and development profiles present, no legacy sandbox keys")


@dataclass
class CanaryCase:
    profile: str | None  # None runs under the user config's default, as a project layer would see it
    argv: list[str]
    expect_ok: bool
    label: str
    # A denied path that does not exist fails for the wrong reason, so the case
    # is skipped rather than counted as the sandbox working.
    requires: Path | None = None
    subdir: str = "repo"
    codex_home: Path | None = None  # a throwaway CODEX_HOME, for cases about project trust


def canary_cases(outside: Path, scratch: Path) -> list[CanaryCase]:
    home = Path.home()
    auth = codex_home() / "auth.json"
    ssh, aws, library, caches = home / ".ssh", home / ".aws", home / "Library", home / "Library" / "Caches"
    probe_net = ["python3", "-c", "import urllib.request; urllib.request.urlopen('https://example.com', timeout=5)"]
    # Codex re-executes its own binary inside the sandbox to load AGENTS.md, so
    # a profile that blocks the install directory breaks every session at start.
    codex_binary = str(Path(shutil.which("codex") or "codex").resolve())
    return [
        CanaryCase("review", [codex_binary, "--version"], True, "review can exec the codex binary"),
        CanaryCase("review", ["cat", str(auth)], False, "review cannot read codex auth.json", requires=auth),
        CanaryCase("review", ["cat", "normal.txt"], True, "review reads workspace files"),
        CanaryCase("review", ["cat", ".env"], False, "review cannot read .env"),
        CanaryCase("review", ["touch", "should-not-exist"], False, "review cannot write in workspace"),
        CanaryCase("review", ["touch", str(scratch / "written.txt")], True, "review can write in the scratch dir"),
        CanaryCase("review", ["touch", str(outside / "review-escaped.txt")], False, "review cannot write elsewhere under ~/.cache/codex-delegate"),
        CanaryCase("review", ["zsh", "-c", "cat <<EOF\nheredoc\nEOF"], True, "review can use a heredoc"),
        CanaryCase("review", ["python3", "-c", "import tempfile; tempfile.mkdtemp()"], True, "review can make a temp dir"),
        CanaryCase("review", ["ls", str(ssh)], False, "review cannot list ~/.ssh", requires=ssh),
        CanaryCase("review", ["ls", str(aws)], False, "review cannot list ~/.aws", requires=aws),
        CanaryCase("review", probe_net, False, "review has no network"),
        CanaryCase("review", ["git", "log", "--oneline", "-1"], True, "review can run git"),
        CanaryCase("development", [codex_binary, "--version"], True, "development can exec the codex binary"),
        CanaryCase("development", ["touch", "written.txt"], True, "development can write in workspace"),
        CanaryCase("development", ["touch", str(outside / "escaped.txt")], False, "development cannot write outside workspace"),
        CanaryCase("development", ["cat", ".env"], False, "development cannot read .env"),
        CanaryCase("development", ["ls", str(ssh)], False, "development cannot list ~/.ssh", requires=ssh),
        CanaryCase("development", ["ls", str(library)], False, "development cannot list ~/Library", requires=library),
        CanaryCase("development", ["ls", str(caches)], True, "development can read ~/Library/Caches", requires=caches),
        CanaryCase("development", ["cat", str(auth)], False, "development cannot read codex auth.json", requires=auth),
        CanaryCase("development", probe_net, False, "development has no network"),
        # The same project config, granting full access, is loaded only when the project is trusted.
        CanaryCase(None, ["touch", str(outside / "escaped-via-trusted-project.txt")], True,
                   "trusted project config is loaded", subdir="trusted", codex_home=outside / "home-trusting"),
        CanaryCase(None, ["touch", str(outside / "escaped-via-untrusted-project.txt")], False,
                   "untrusted project config is ignored", subdir="untrusted", codex_home=outside / "home-trusting"),
    ]


def run_canaries() -> list[Check]:
    """Exercise both profiles with `codex sandbox` on throwaway files under $HOME (not /tmp: that is writable by design)."""
    parent = Path.home() / ".cache" / "codex-delegate"
    parent.mkdir(parents=True, exist_ok=True)
    root = Path(tempfile.mkdtemp(prefix="canary-", dir=parent))
    repo, outside, trusted, untrusted = root / "repo", root / "outside", root / "trusted", root / "untrusted"
    repo.mkdir()
    outside.mkdir()
    (repo / ".env").write_text("CANARY=not-a-secret\n")
    (repo / "normal.txt").write_text("hello\n")
    for project in (trusted, untrusted):
        (project / ".codex").mkdir(parents=True)
        (project / ".codex" / "config.toml").write_text('default_permissions = ":danger-full-access"\n')
    # A throwaway CODEX_HOME whose default profile denies the write, so only a loaded project config can allow it.
    home = outside / "home-trusting"
    home.mkdir()
    (home / "config.toml").write_text(
        f'default_permissions = "locked"\n[permissions.locked]\nextends = ":read-only"\n[projects."{trusted}"]\ntrust_level = "trusted"\n'
    )
    git_env = {**os.environ, "GIT_CONFIG_GLOBAL": "/dev/null"}
    checks = []
    try:
        for cwd in (repo, trusted, untrusted):
            for git_args in (["init", "-q", "."], ["-c", "user.name=canary", "-c", "user.email=canary@example.invalid", "commit", "-q", "--allow-empty", "-m", "init"]):
                setup = run_capture(["git", *git_args], cwd=cwd, env=git_env)
                if setup.returncode != 0:
                    return [Check("canary setup", False, f"git {' '.join(git_args)} failed: {setup.stderr.strip()}")]
        with run_scratch("review") as scratch_vars:
            scratch = Path(scratch_vars["TMPDIR"])
            for case in canary_cases(outside, scratch):
                if case.requires is not None and not case.requires.exists():
                    checks.append(Check(f"canary: {case.label}", True, f"skipped: {case.requires} not present", skipped=True))
                    continue
                pin = config_override("default_permissions", case.profile) if case.profile else []
                argv = ["codex", *pin, "sandbox", "--", *case.argv]
                env = {**os.environ, **scratch_vars}  # the temp-file environment a review run gets
                if case.codex_home:
                    env["CODEX_HOME"] = str(case.codex_home)
                result = run_capture(argv, cwd=root / case.subdir, env=env)
                ok = (result.returncode == 0) == case.expect_ok
                detail = "as expected" if ok else f"exit {result.returncode}: {shlex.join(argv)}\n{result.stderr.strip()}"
                checks.append(Check(f"canary: {case.label}", ok, detail))
        checks.append(Check("scratch dir removed after the run", not scratch.exists(), "gone" if not scratch.exists() else f"{scratch} still exists"))
    finally:
        shutil.rmtree(root, ignore_errors=True)
    return checks


def run_doctor(skip_canary: bool) -> list[Check]:
    version = codex_version()
    checks = [check_binary(version)]
    if not checks[0].ok:
        return checks
    checks.append(check_codex_doctor(run_capture(["codex", "doctor", "--json"], timeout=120).stdout))
    checks.append(check_models(run_capture(["codex", "debug", "models"]).stdout))
    checks.append(check_flags("codex exec flags", run_capture(["codex", "exec", "--help"]).stdout, REQUIRED_EXEC_FLAGS))
    checks.append(
        check_flags("codex exec review flags", run_capture(["codex", "exec", "review", "--help"]).stdout, REQUIRED_REVIEW_FLAGS)
    )
    config_path = codex_home() / "config.toml"
    if config_path.exists():
        checks.append(check_config_file(config_path.read_text(encoding="utf-8")))
    else:
        checks.append(Check("config profiles", False, f"{config_path} does not exist"))
    if not skip_canary and all(check.ok for check in checks):
        checks.extend(run_canaries())
    return checks


def print_checks(checks: list[Check]) -> None:
    for check in checks:
        mark = "skip" if check.skipped else ("WARN" if check.warning else ("ok" if check.ok else "FAIL"))
        print(f"[{mark:>4}] {check.name}: {check.detail}")


# --- CLI --------------------------------------------------------------------


def read_prompt(value: str | None) -> str:
    """Return the prompt text, reading stdin when the value is '-' or absent."""
    if value is None or value == "-":
        text = sys.stdin.read()
        if not text.strip():
            raise DelegateError("no prompt given (pass it as an argument or on stdin)")
        return text
    return value


def read_focus(words: list[str]) -> str:
    """Return adversarial focus text, reading stdin only when the sole word is '-'."""
    if words == ["-"]:
        text = sys.stdin.read()
        if not text.strip():
            raise DelegateError("'-' given but no focus text on stdin")
        return text
    return " ".join(words)


def add_common_options(parser: argparse.ArgumentParser, model_required: bool = False, inherit: bool = False) -> None:
    if inherit:
        parser.add_argument("--model", default=None, help="Codex model slug (default: the session's own model)")
        parser.add_argument("--effort", default=None, choices=EFFORTS, help="reasoning effort (default: the session's own effort)")
        parser.add_argument("--cwd", type=Path, default=None, help="repository to work in (default: the session's own directory)")
    else:
        parser.add_argument("--model", required=model_required, default=None if model_required else DEFAULT_MODEL,
                            help=f"Codex model slug (default: {DEFAULT_MODEL}; escalation: {ESCALATION_MODEL})")
        parser.add_argument("--effort", default=DEFAULT_EFFORT, choices=EFFORTS, help=f"reasoning effort (default: {DEFAULT_EFFORT})")
        parser.add_argument("--cwd", type=Path, default=None, help="repository to work in (default: current directory)")
    parser.add_argument("--json", action="store_true", help="print a JSON report instead of text")
    parser.add_argument("--allow-project-config", action="store_true",
                        help="run even if the trusted project's own .codex/ could change the sandbox")
    parser.add_argument("--dry-run", action="store_true", help="print the codex command and exit")
    parser.add_argument("--verbose", action="store_true", help="echo Codex JSONL events to stderr while running")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codex-delegate",
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Intents and the permission profile they pin:\n"
            "  review, adversarial, consult -> review      (read-only, no network, secrets denied)\n"
            "  implement, resume --write    -> development (workspace writes, no network, secrets denied)\n"
            f"\nDefaults: model {DEFAULT_MODEL}, effort {DEFAULT_EFFORT}. consult requires an explicit --model."
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    review = sub.add_parser("review", help="native Codex code review of a branch or the working tree")
    target = review.add_mutually_exclusive_group()
    target.add_argument("--base", metavar="REF", help="review the branch against this base ref")
    target.add_argument("--uncommitted", action="store_true", help="review staged, unstaged, and untracked changes (default)")
    add_common_options(review)

    adversarial = sub.add_parser("adversarial", help="challenge the design and assumptions behind a change")
    target = adversarial.add_mutually_exclusive_group()
    target.add_argument("--base", metavar="REF")
    target.add_argument("--uncommitted", action="store_true")
    adversarial.add_argument("focus", nargs="*", help="areas to concentrate on (free text); '-' reads stdin")
    add_common_options(adversarial)

    consult = sub.add_parser("consult", help="read-only investigation or opinion; the model must be named")
    consult.add_argument("prompt", nargs="?", help="question or task; '-' or omitted reads stdin")
    add_common_options(consult, model_required=True)

    implement = sub.add_parser("implement", help="write-capable task under the development profile")
    implement.add_argument("prompt", nargs="?", help="task; '-' or omitted reads stdin")
    implement.add_argument("--worktree", action="store_true", help="run in a new managed git worktree")
    add_common_options(implement)

    resume = sub.add_parser("resume", help="continue a previous session in its own directory")
    resume.add_argument("session_id")
    resume.add_argument("prompt", nargs="?", help="follow-up; '-' or omitted reads stdin")
    resume.add_argument("--write", action="store_true", help="use the development profile instead of review")
    add_common_options(resume, inherit=True)

    show = sub.add_parser("show", help="report model, effort, profile, and last message for a session")
    show.add_argument("session_id")
    show.add_argument("--json", action="store_true")

    doctor = sub.add_parser("doctor", help="check the Codex install, config, flags, and sandbox behaviour (no model calls)")
    doctor.add_argument("--skip-canary", action="store_true", help="skip the sandbox canary runs")
    return parser


def request_from_args(args: argparse.Namespace) -> tuple[Request, str | None]:
    """Turn parsed arguments into a Request plus the stdin text for Codex."""
    request = Request(intent=args.command, cwd=Path.cwd(), model=args.model, effort=args.effort,
                      allow_project_config=args.allow_project_config)
    cwd = args.cwd
    if args.command == "resume":
        # A resumed session runs where it started (a worktree, say) unless told
        # otherwise, and only a turn newer than the ones it already has can verify it.
        request.session_id = args.session_id
        request.write = args.write
        existing = load_summary(args.session_id)
        if existing is not None:
            request.prior_turn_ids = set(existing.turn_ids)
            if cwd is None and existing.cwd and Path(existing.cwd).is_dir():
                cwd = Path(existing.cwd)
    request.cwd = (cwd or Path.cwd()).resolve()

    stdin_text: str | None = None
    if args.command in ("review", "adversarial"):
        request.base = args.base
        if request.base and not git_output(["rev-parse", "--verify", "--quiet", f"{request.base}^{{commit}}"], request.cwd):
            raise DelegateError(f"base ref {request.base!r} not found in {request.cwd}")
    if args.command == "adversarial":
        stdin_text = adversarial_prompt(request, read_focus(args.focus))
    elif args.command in ("consult", "implement", "resume"):
        stdin_text = read_prompt(args.prompt)
    if args.command == "implement":
        request.worktree = args.worktree
    return request, stdin_text


def run_request(args: argparse.Namespace) -> int:
    request, stdin_text = request_from_args(args)
    if request.allow_project_config:
        print("codex-delegate: --allow-project-config set; the project's .codex/ was not checked", file=sys.stderr)
        problems = []
    else:
        problems = project_config_problems(request.cwd)
    if problems:
        raise DelegateError(
            "refusing to run: this trusted project's .codex/ could change the sandbox "
            "(--allow-project-config overrides)\n  " + "\n  ".join(problems)
        )
    with tempfile.TemporaryDirectory(prefix="codex-delegate-") as tmp:
        output_file = Path(tmp) / "last-message.txt"
        schema_file = None
        if request.intent == "adversarial":
            schema_file = Path(tmp) / "findings.schema.json"
            schema_file.write_text(json.dumps(FINDINGS_SCHEMA))
        argv = build_command(request, output_file, schema_file)
        if args.dry_run:
            print(shlex.join(argv))
            if stdin_text:
                print("--- stdin ---")
                print(stdin_text, end="")
            return 0
        with run_scratch(request.profile) as env:
            run = run_codex(argv, request.cwd, stdin_text, env, verbose=args.verbose)
        last_message = output_file.read_text(encoding="utf-8") if output_file.exists() else None
    report = build_report(request, argv, run, last_message)
    print_report(report, args.json)
    return run.exit_code


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "show":
            summary = load_summary(args.session_id)
            if summary is None:
                raise DelegateError(f"no rollout found for session {args.session_id}")
            print_summary(summary, args.json)
            return 0
        if args.command == "doctor":
            checks = run_doctor(args.skip_canary)
            print_checks(checks)
            return 0 if all(check.ok for check in checks) else 1
        return run_request(args)
    except DelegateError as exc:
        print(f"codex-delegate: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    # A cancelled background run arrives as SIGTERM; exit through the `finally` blocks so the scratch directory goes too.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
    sys.exit(main())
